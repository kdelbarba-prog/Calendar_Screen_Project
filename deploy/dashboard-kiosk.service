[Unit]
Description=Calendar Screen Chromium Kiosk
After=graphical-session.target network-online.target
Wants=network-online.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DASHBOARD_URL=http://127.0.0.1:8080/
ExecStart=/opt/calendar-screen/deploy/kiosk.sh
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=default.target
